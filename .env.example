# ==== Núcleo ====
PORT=3000
NODE_ENV=production
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/provas_live

# ==== Seed do primeiro admin (usado só por scripts/seed-admin.js) ====
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=troque-esta-senha

# ==== STUN/TURN (WebRTC) ====
# STUN sozinho NÃO é suficiente para todo mundo conseguir se conectar —
# funciona só quando os dois lados (aluno e fiscal) conseguem estabelecer
# conexão direta. Em CGNAT, firewall corporativo, ou várias combinações de
# rede comuns, é OBRIGATÓRIO ter um servidor TURN de relay, senão a
# transmissão simplesmente não conecta para uma parte dos usuários — este é
# o sintoma "nem todo mundo consegue ver a transmissão".
STUN_URLS=stun:stun.l.google.com:19302

# Opção A — provedor de TURN gratuito pronto (mais simples, recomendado
# para começar): crie uma conta grátis em
# https://www.metered.ca/tools/openrelay/ (ou outro provedor de TURN) e
# copie as credenciais que ele fornece.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Opção B — seu próprio servidor coturn com "use-auth-secret" habilitado
# (gera credenciais temporárias via HMAC em vez de usuário/senha fixos).
# Use OU esta opção OU a A acima, não as duas.
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=43200

# ==== Cookies de sessão ====
# Defina como "true" quando servido atrás de HTTPS (obrigatório em produção)
COOKIE_SECURE=true

# ==== Bot do Discord (opcional) ====
# Com DISCORD_ENABLED diferente de "true", o site funciona normalmente sem o
# bot. Passo a passo completo (para leigo) em DISCORD-SETUP.md.
# NUNCA coloque o token em arquivo que vai para o Git — só no painel de
# variáveis de ambiente do Render (ou num .env local, que é ignorado pelo Git).
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
# "Application ID" do Developer Portal (General Information)
DISCORD_CLIENT_ID=
# ID do servidor do Discord onde o bot vai funcionar (só esse servidor)
DISCORD_GUILD_ID=
# A URL pública usada nos links que o bot entrega vem sozinha do Render
# (RENDER_EXTERNAL_URL, definida automaticamente pelo próprio Render).
# Em teste local ela cai em http://localhost:PORT.
