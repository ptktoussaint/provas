# ==== Núcleo ====
PORT=3000
NODE_ENV=production
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/provas_live

# ==== Seed do primeiro admin (usado só por scripts/seed-admin.js) ====
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=troque-esta-senha

# ==== STUN/TURN (WebRTC) ====
# STUN público sempre disponível. TURN é opcional mas fortemente recomendado
# em produção para redes com NAT/firewall restritivo (ver lib/turn.js).
STUN_URLS=stun:stun.l.google.com:19302
# Servidor coturn (ou equivalente) com "use-auth-secret" habilitado.
# Se TURN_URLS ou TURN_SECRET não forem definidos, a plataforma funciona
# apenas com STUN — funcional na maioria das redes domésticas, mas sem
# garantia de conexão em redes corporativas/CGNAT.
TURN_URLS=
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=43200

# ==== Cookies de sessão ====
# Defina como "true" quando servido atrás de HTTPS (obrigatório em produção)
COOKIE_SECURE=true
