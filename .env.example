# ==== Núcleo ====
PORT=3000
NODE_ENV=production
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/provas_live

# ==== Seed do primeiro admin (usado só por scripts/seed-admin.js) ====
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=troque-esta-senha

# ==== STUN/TURN (WebRTC) ====
# STUN sozinho NÃO é suficiente para todo mundo conseguir se conectar —
# funciona só quando os dois lados (aluno e fiscal) conseguem estabelecer
# conexão direta. Em CGNAT, firewall corporativo, ou várias combinações de
# rede comuns, é OBRIGATÓRIO ter um servidor TURN de relay, senão a
# transmissão simplesmente não conecta para uma parte dos usuários — este é
# o sintoma "nem todo mundo consegue ver a transmissão".
STUN_URLS=stun:stun.l.google.com:19302

# Opção A — provedor de TURN gratuito pronto (mais simples, recomendado
# para começar): crie uma conta grátis em
# https://www.metered.ca/tools/openrelay/ (ou outro provedor de TURN) e
# copie as credenciais que ele fornece.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Opção B — seu próprio servidor coturn com "use-auth-secret" habilitado
# (gera credenciais temporárias via HMAC em vez de usuário/senha fixos).
# Use OU esta opção OU a A acima, não as duas.
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=43200

# ==== Cookies de sessão ====
# Defina como "true" quando servido atrás de HTTPS (obrigatório em produção)
COOKIE_SECURE=true

# ==== Integração com o bot do BotGhost (opcional) ====
# O bot continua hospedado no BotGhost. O site NÃO conecta no Discord e NÃO
# usa o token do bot (nunca coloque o token do Discord aqui).
# Passo a passo: RENDER-GRATUITO.md, BOTGHOST-API.md e BOTGHOST-MONTAGEM.md.
# Segredos só no painel "Environment" do Render (ou num .env local, que é
# ignorado pelo Git) — nunca em arquivo commitado, print ou chat.
BOTGHOST_INTEGRATION_ENABLED=false
# Chave que o BotGhost manda em "Authorization: Bearer ...". Mínimo 32
# caracteres. Gere no seu computador com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# e guarde a MESMA no BotGhost em Manage Secrets.
BOTGHOST_SITE_API_KEY=
# ID do servidor do Discord (só pedidos desse servidor são aceitos)
BOTGHOST_ALLOWED_GUILD_ID=
# Avisos do site → BotGhost pelo módulo Webhooks (deixe false até montar o
# evento de webhook no BotGhost)
BOTGHOST_NOTIFICATIONS_ENABLED=false
# URL do evento, copiada do módulo Webhooks: https://api.botghost.com/webhook/<bot>/<evento>
BOTGHOST_WEBHOOK_URL=
# "API Key" do módulo Webhooks do BotGhost (NÃO é o token do Discord e NÃO é
# a BOTGHOST_SITE_API_KEY)
BOTGHOST_WEBHOOK_API_KEY=
# A URL pública usada nos links de prova vem sozinha do Render
# (RENDER_EXTERNAL_URL). Em teste local ela cai em http://localhost:PORT.
